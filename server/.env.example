# ═══════════════════════════════════════════
# NEBULA CHAT - Server Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Environment ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────
# Local: PostgreSQL in Docker
DATABASE_URL=postgresql://nebula_admin:nebula_dev_pass_2024@localhost:5433/nebula_chat_dev
DATABASE_SSL=false
# Production: Neon serverless PostgreSQL
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_SSL=true

# ── Redis ──────────────────────────────────────────────────────────
# Local: Redis in Docker
REDIS_URL=redis://:nebula_redis_pass_new@localhost:6380
# Production: Upstash serverless Redis
# REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# ── JWT ────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-this-to-another-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Production
# GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/v1/auth/google/callback

# ── Email ──────────────────────────────────────────────────────────
# Local: MailHog (no auth, no real emails sent)
EMAIL_FROM=noreply@nebula-chat.local
EMAIL_HOST=localhost
EMAIL_PORT=1026
EMAIL_USER=
EMAIL_PASS=
EMAIL_PROVIDER=smtp
# Production: Resend API
# EMAIL_FROM=onboarding@resend.dev
# EMAIL_PASS=re_your_api_key

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# Production
# CORS_ORIGIN=https://your-app.vercel.app

# ── Cookie ─────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Production
# COOKIE_DOMAIN=
# COOKIE_SECURE=true

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Production: LOG_LEVEL=info
