# ═══════════════════════════════════════════
# NEBULA CHAT - Server Environment Variables
# ═══════════════════════════════════════════

# Environment
NODE_ENV=development
PORT=4000

# Database (Docker)
DATABASE_URL=postgresql://nebula_admin:nebula_dev_pass_2024@localhost:5433/nebula_chat_dev
DATABASE_SSL=false

# Redis (Docker)
REDIS_URL=redis://:nebula_redis_pass@localhost:6380
REDIS_TOKEN=

# JWT Configuration
JWT_ACCESS_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-this-to-another-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email Configuration (MailHog for development)
EMAIL_FROM=noreply@nebula-chat.local
EMAIL_HOST=localhost
EMAIL_PORT=1026
EMAIL_USER=
EMAIL_PASS=
EMAIL_PROVIDER=smtp

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug